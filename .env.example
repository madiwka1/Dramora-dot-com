# Copy to .env.local. Without VITE_SUPABASE_* the app runs in demo mode (in-memory data).
VITE_SITE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_POSTHOG_KEY=
# Server only (Supabase Edge Function secrets — never prefix with VITE_):
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Stripe price per product id in config plans.plus / tokens.packs:
STRIPE_PRICE_PLUS_WEEKLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_TOKENS_STARTER=
STRIPE_PRICE_TOKENS_BASIC=
STRIPE_PRICE_TOKENS_PRO=
STRIPE_PRICE_TOKENS_ULTIMATE=
LLM_API_KEY=
IMAGE_API_KEY=
TTS_API_KEY=
